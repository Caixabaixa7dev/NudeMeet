PORT=4000

# Credenciais do gateway VeoPag (portal > Credenciais)
VEOPAG_CLIENT_ID=
VEOPAG_CLIENT_SECRET=
VEOPAG_WEBHOOK_SECRET=

# Documento do pagador usado na cobranca (CPF 11 ou CNPJ 14 digitos)
VEOPAG_PAYER_DOCUMENT=

# URL publica do backend (usada no webhook). Em dev local pode ficar vazio.
PUBLIC_URL=

# Origem permitida pelo CORS (frontend)
FRONTEND_URL=http://localhost:5173
